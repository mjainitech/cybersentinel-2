# Copy this file to .env and fill in real values. Never commit .env.
# Every key below is optional — if one is missing, the related check
# simply reports as "unknown" instead of the server failing to start.

PORT=8787
FRONTEND_ORIGIN=http://localhost:5173

# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# https://urlscan.io/user/profile/ (API tab)
URLSCAN_API_KEY=

# https://whoisxmlapi.com/ (or swap the provider in src/services/whois.ts)
WHOIS_API_KEY=

# https://ipgeolocation.io/
IP_GEOLOCATION_API_KEY=

# https://console.anthropic.com/settings/keys — powers the beginner-friendly
# AI explanation card. Without this, explanations fall back to a
# template-based summary instead of a real AI-generated one.
ANTHROPIC_API_KEY=

# https://haveibeenpwned.com/API/Key (paid) — required for the Data Breach Checker, no fallback exists for this one.
HIBP_API_KEY=

# https://nvd.nist.gov/developers/request-an-api-key (free, optional) — raises the NVD rate limit for the Threat Intelligence Dashboard's CVE data. Works without it at a lower rate limit.
NVD_API_KEY=

# Any long random string — signs login session tokens. If left blank,
# a random one is generated at boot, which means everyone gets logged
# out every time the server restarts. Set a real value for anything
# beyond local dev. Generate one with: openssl rand -hex 32
JWT_SECRET=

# https://neon.tech (free, permanent tier) — a real Postgres connection
# string. Without this, user accounts fall back to a local JSON file,
# which does NOT survive a restart on hosts with an ephemeral
# filesystem (e.g. Render's free tier) — accounts will appear to
# randomly disappear. Strongly recommended for anything beyond a
# five-minute local test. Format: postgres://user:pass@host/dbname
DATABASE_URL=

# https://resend.com (free tier: 100 emails/day, no credit card) —
# used to actually send password-reset emails. Without this, the
# forgot-password flow still works internally (generates a valid
# reset link) but can't deliver it to the user.
RESEND_API_KEY=

# How long a scan result stays cached before a re-scan hits the APIs again.
CACHE_TTL_MINUTES=15

# How long to wait on any single external API call before treating it as failed.
REQUEST_TIMEOUT_MS=6000

# Maximum resume PDF size accepted by the Resume Privacy Scanner.
RESUME_MAX_FILE_SIZE_MB=5
